# Copy this file to .env and fill in. Never share or commit .env.
# Secret key: public.com > Settings > Security > API
PUBLIC_API_SECRET_KEY=
PUBLIC_ACCOUNT_ID=

# --- Alpaca (only if broker: alpaca in config.yaml) ---
# Paper and live accounts have DIFFERENT keys: generate them on the matching dashboard page.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- NinjaTrader (only if broker: ninjatrader in config.yaml) ---
# CID and secret come from NinjaTrader's web platform: Settings > API Access (shown once - save them).
NINJA_USERNAME=
NINJA_PASSWORD=
NINJA_CID=
NINJA_SECRET=
